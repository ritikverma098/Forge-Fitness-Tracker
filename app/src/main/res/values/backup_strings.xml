<resources>
    <string name="backup_title">Backup &amp; restore</string>
    <string name="backup_description">Save your workouts, exercise library, routines, personal nutrition data and settings as a JSON file. Your active workout is included; reference food catalogs stay on this device.</string>
    <string name="backup_create">Create backup</string>
    <string name="backup_restore">Restore backup</string>
    <string name="backup_file_name">forge-backup-%1$s.json</string>
    <string name="backup_file_hint">Choose a Forge JSON backup to review before restoring.</string>
    <string name="backup_operation_busy">Working with your backup…</string>
    <string name="backup_restore_busy">Restoring your backup…</string>
    <string name="backup_restore_confirm_title">Restore this backup?</string>
    <string name="backup_created_at">Created %1$s</string>
    <string name="backup_restore_replaces">Restoring replaces your workouts, exercise library, routines and app preferences, including any active workout.</string>
    <string name="backup_restore_replaces_nutrition">Restoring replaces your workouts, exercise library, routines, app preferences and personal nutrition data. This includes custom foods, recipes, diary entries, favorites, goals, body-weight records and calorie settings.</string>
    <string name="backup_reference_catalogs_kept">Installed reference food catalogs are kept. Workout calorie records are restored with the workouts in this file.</string>
    <string name="backup_legacy_nutrition_kept">This workout-only backup keeps your existing foods, recipes, diary entries, favorites, goals, body weights and nutrition settings. Linked workout calorie records are regenerated for the restored workouts.</string>
    <string name="backup_restore_confirm">Replace and restore</string>
